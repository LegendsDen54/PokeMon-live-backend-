{
  "manifest_version": 3,
  "name": "Pokémon Center Signal Sensor",
  "version": "1.3.7",
  "description": "Sends visible Pokémon Center and Best Buy product availability to the owner's private monitor.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.pokemoncenter.com/*",
    "https://www.bestbuy.com/*",
    "https://x.com/PokemonRestocks*",
    "https://pokemon-live-backend.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pokémon Center Signal Sensor",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pokemoncenter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/PokemonRestocks*"],
      "js": ["pokemon-restocks.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bestbuy.com/site/*",
        "https://www.bestbuy.com/product/*"
      ],
      "js": ["bestbuy.js"],
      "run_at": "document_idle"
    }
  ]
}
