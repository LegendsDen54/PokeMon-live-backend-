{
  "manifest_version": 3,
  "name": "Pokémon Center Signal Sensor",
  "version": "1.4.13",
  "description": "Public product sensor for Pokémon Center, Target, Best Buy, Sam's Club and Costco.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.pokemoncenter.com/*",
    "https://www.bestbuy.com/*",
    "https://www.samsclub.com/*",
    "https://www.costco.com/*",
    "https://x.com/PokemonRestocks*",
    "https://pokemon-live-backend.onrender.com/*",
    "https://www.target.com/*",
    "https://discord.com/channels/1410547930250612828/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pokémon Center Signal Sensor",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pokemoncenter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/PokemonRestocks*"
      ],
      "js": [
        "pokemon-restocks.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bestbuy.com/site/*",
        "https://www.bestbuy.com/product/*"
      ],
      "js": [
        "bestbuy.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.samsclub.com/ip/*"
      ],
      "js": [
        "retail-product.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.costco.com/*"
      ],
      "js": [
        "retail-product.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.target.com/p/*"
      ],
      "js": [
        "target.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://discord.com/channels/1410547930250612828/*"
      ],
      "js": [
        "ccn-discord.js"
      ],
      "run_at": "document_idle"
    }
  ]
}